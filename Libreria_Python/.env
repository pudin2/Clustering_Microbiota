# Agente matemático local con Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini-reasoning

# Perfil rápido: suficiente para la revisión de rutas del agente.
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=160
OLLAMA_TEMPERATURE=0.05

# Evita recargar el modelo entre consultas consecutivas.
OLLAMA_KEEP_ALIVE=30m

# Corte de seguridad de la llamada del asistente.
LLM_TIMEOUT_SECONDS=180

